######################################################################################
### Oxigraph settings                                                              ###
######################################################################################
# Published port of the SPARQL endpoint / web UI
OXIGRAPH_HTTP_PORT=7878

# Directory holding the store (relative to this file).
# It ends up with db/ (the RocksDB store) and .loaded/ (per-file load markers).
STORE_DIR=./store

# Subcommand the server runs.
#   serve-read-only : read-only; several readers may open the same store
#   serve           : read-write; SPARQL UPDATE and the /store HTTP API work
OXIGRAPH_SERVE_CMD=serve-read-only

# Extra flags for that subcommand.
#   --union-default-graph : queries without GRAPH/FROM also see the named graph
#   --cors                : allow cross-origin requests
#   --timeout-s <SECONDS> : per-query timeout
OXIGRAPH_SERVE_OPTS=--union-default-graph --cors

######################################################################################
### Dump settings                                                                  ###
######################################################################################
# Root of the DBpedia Japanese dumps and the version (= directory name).
# Available versions are listed at https://ja.dbpedia.org/dumps/
DUMP_BASE_URL=https://ja.dbpedia.org/dumps
DUMP_VERSION=20221201

# Download target directory (relative to this file).
# The files themselves end up in ${DATA_DIR}/${DUMP_VERSION}/
DATA_DIR=./data

# Which set of dump files to fetch:
#   core : _lang=ja without NIF / raw-tables / wikilinks / article-templates (~0.9 GB)
#   ja   : every _lang=ja file (~5.9 GB)
#   full : every file in the dump directory, including the multilingual ones (~29 GB)
DUMP_PROFILE=core

# Extra filters that override the profile (POSIX extended regex, matched against
# the file name).
# e.g. DUMP_INCLUDE_REGEX='^(labels|short-abstracts|instance-types)_lang=ja'
DUMP_INCLUDE_REGEX=
DUMP_EXCLUDE_REGEX=

# File names always added on top of the profile result (whitespace separated)
DUMP_EXTRA_FILES=ontology-subclassof.ttl.bz2

# Number of concurrent downloads
DOWNLOAD_PARALLEL=4

# Must stay true: oxigraph reads gzip but not bzip2, and the dumps ship as .bz2.
RECOMPRESS_BZ2_TO_GZ=true

######################################################################################
### Load settings                                                                  ###
######################################################################################
# Named graph that holds every triple
GRAPH_URI=http://ja.dbpedia.org

# Keep loading even when the data is invalid. DBpedia dumps do contain malformed
# IRIs and language tags, so this is on by default.
LOAD_LENIENT=true

# Write to the database while loading instead of only at the end. Uses far less
# disk at the cost of CPU, which is what you want for dumps this size.
LOAD_NON_ATOMIC=true

# Files handed to one `oxigraph load` call. They are loaded in parallel, and
# progress is recorded after each batch. Lower it if the loader runs out of memory.
LOAD_BATCH_SIZE=4

# Run `oxigraph optimize` after loading. Slow, but pays off for a read-only mirror.
RUN_OPTIMIZE=true
