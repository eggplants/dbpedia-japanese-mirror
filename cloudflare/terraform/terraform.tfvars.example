account_id = "0123456789abcdef0123456789abcdef"
zone_name  = "egpl.dev"
hostname   = "ja-dbpedia.egpl.dev"

# Is DNS zone managed by Cloudflare?
manage_zone = false
# Existing hosted zone ID
# zone_id = "fedcba9876543210fedcba9876543210"

source_repository = "https://github.com/eggplants/dbpedia-japanese-mirror"

# Use *.workers.dev domain
enable_workers_dev = false

# Must match DUMP_VERSION in docker-compose/.env
dataset_version = "20221201"

# Must match DUMP_PROFILE in docker-compose/.env
dataset_profile = "core"

# Pushed by `make push`; the tag is DUMP_VERSION by default
container_image = "dbpedia-ja-oxigraph:20221201"

# Sizing. Measured at 114 bytes/triple in the default graph and roughly twice
# that in a named graph; the core profile is around 54M triples and unpacks to
# about 16.3 GB on disk. Serving needs very little memory (64 MB RSS on a
# 34M-triple store), but custom instance types allow at most 2 GB of disk per
# 1 GiB of memory, so memory follows disk; the surplus is page cache.
container_vcpu          = 1
container_memory_mib    = 9216
container_disk_mb       = 18000
container_max_instances = 3
container_sleep_after   = "20m"
container_pool_size     = 1

# Rate limits (per IP, per Cloudflare location)
rate_limit_burst     = 30
rate_limit_sustained = 120
rate_limit_heavy     = 10

# Zone-level ceiling. On the Free plan mitigation_timeout has to be 10.
zone_rate_limit_requests           = 300
zone_rate_limit_mitigation_timeout = 60
